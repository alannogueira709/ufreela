## Gere com:
## python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
## Obrigatorio porque tokens OAuth, documentos e IDs sensiveis usam campos criptografados.
FIELD_ENCRYPTION_KEY=
## Obrigatorio quando DEBUG=0. Em desenvolvimento, DEBUG=1 usa uma chave insegura local.
DJANGO_SECRET_KEY=
DB_NAME=freela
DB_USER=freela_user
DB_PASSWORD=freela_pass
DB_HOST=db
DB_PORT=5432
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
LINKEDIN_CLIENT_ID=''
LINKEDIN_CLIENT_SECRET=''
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET=''
FRONTEND_URL=http://localhost:3000
LINKEDIN_API_VERSION=202601
GITHUB_API_VERSION=2026-03-10

## Setup local recomendado:
## 1. cp .env_example .env
## 2. preencha FIELD_ENCRYPTION_KEY
## 3. docker compose up --build
## Checks backend quando o ambiente Python/Docker estiver disponivel:
## python manage.py check
## python manage.py test users jobs finances settings_app integrations
