## Copie este arquivo para .env e preencha os valores reais:
##   cp .env_example .env
##
## NUNCA commite o arquivo .env. Ele ja esta listado no .gitignore.

# === Django core ===
## Gere com:
## python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
## Obrigatorio porque tokens OAuth, documentos e IDs sensiveis usam campos criptografados.
FIELD_ENCRYPTION_KEY=

## Obrigatorio quando DEBUG=0. Em desenvolvimento, DEBUG=1 usa uma chave insegura local.
DJANGO_SECRET_KEY=

DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,backend
FRONTEND_URL=http://localhost:3000

# === Banco de dados ===
DB_NAME=freela
DB_USER=freela_user
DB_PASSWORD=freela_pass
DB_HOST=db
DB_PORT=5432

# Em vez de DB_* separados, pode usar uma DATABASE_URL completa:
# DATABASE_URL=postgres://freela_user:freela_pass@db:5432/freela

# === CORS / CSRF ===
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# === Cookies de autenticacao ===
# Em producao (HTTPS) defina como 1. Localmente pode deixar vazio (default baseado em DEBUG).
AUTH_COOKIE_SECURE=
# SameSite eh detectado automaticamente pelo settings.py: Lax quando frontend e
# backend compartilham o mesmo dominio registrado, None quando sao sites distintos.
# Use essa variavel apenas se quiser sobrescrever a deteccao automatica.
AUTH_COOKIE_SAMESITE=Lax

# === Email ===
# Provedor SMTP padrao (desabilitado localmente se nao houver credenciais).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="uFreela <no-reply@ufreela.com.br>"

# Resend (API de email transacional)
RESEND_API_KEY=
RESEND_FROM_EMAIL="uFreela <noreply@ufreela.com.br>"

# === Redis (cache, sessoes, channels) ===
REDIS_URL=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/0

# === OAuth / Provedores sociais ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
GITHUB_API_VERSION=2026-03-10

# === Pagamentos ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Armazenamento de midia (Supabase S3) ===
SUPABASE_S3_ENDPOINT=
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_NAME=ufreela-media
SUPABASE_REGION=sa-east-1

# === Allauth ===
# mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=none

# === Setup local recomendado ===
# 1. cp .env_example .env
# 2. preencha FIELD_ENCRYPTION_KEY
# 3. docker compose up --build
#
# Checks backend quando o ambiente Python/Docker estiver disponivel:
# python manage.py check
# python manage.py test users jobs finances settings_app integrations messages
